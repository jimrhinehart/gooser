
(
SynthDef(\tone, {
	| freq = 200, env, sig |
	sig = Pulse.ar(freq, 0.5);
	env = EnvGen.ar(Env.perc(0.01, 0.5), doneAction: 2);
	sig = sig * env;
	Out.ar(0, sig);
}).add;

SynthDef(\drum, {
	|amp, env, sig |
	sig = WhiteNoise.ar;
	env = EnvGen.ar(Env.perc(0.01, 0.2), doneAction: 2);
	sig = sig * env;
	Out.ar(0, sig * amp);
}).add;
)

